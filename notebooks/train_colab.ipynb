   "source": [
    "{\n",
    " \"nbformat\": 4,\n",
    " \"nbformat_minor\": 5,\n",
    " \"metadata\": {\n",
    "  \"colab\": {\"provenance\": [], \"gpuType\": \"T4\"},\n",
    "  \"kernelspec\": {\"name\": \"python3\", \"display_name\": \"Python 3\"},\n",
    "  \"accelerator\": \"GPU\"\n",
    " },\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"m1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\"# \\ud83d\\udea2 YOLO at Sea \\u2014 Wreck Detection (Single Class)\\n\", \"\\n\", \"**Classe unica: 0 = Wreck**\\n\", \"\\n\", \"1. Runtime \\u2192 Change runtime type \\u2192 T4 GPU\\n\", \"2. Carica dataset.zip\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c1\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"!nvidia-smi\\n\", \"import torch\\n\", \"print(f'CUDA: {torch.cuda.is_available()} - {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \\\"CPU\\\"}')\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c2\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"!pip install -q ultralytics opencv-python-headless\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c3\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from google.colab import files\\n\", \"import zipfile\\n\", \"print('Upload dataset.zip...')\\n\", \"uploaded = files.upload()\\n\", \"with zipfile.ZipFile('dataset.zip', 'r') as z:\\n\", \"    z.extractall('/content')\\n\", \"print('Done!')\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c4\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"import yaml\\n\", \"\\n\", \"config = {\\n\", \"    'path': '/content/dataset',\\n\", \"    'train': 'images/train',\\n\", \"    'val': 'images/val',\\n\", \"    'nc': 1,\\n\", \"    'names': {0: 'Wreck'}\\n\", \"}\\n\", \"with open('/content/dataset.yaml', 'w') as f:\\n\", \"    yaml.dump(config, f)\\n\", \"print('dataset.yaml created: nc=1, class 0=Wreck')\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from pathlib import Path\\n\", \"from collections import Counter\\n\", \"\\n\", \"train_lbls = list(Path('/content/dataset/labels/train').glob('*.txt'))\\n\", \"val_lbls = list(Path('/content/dataset/labels/val').glob('*.txt'))\\n\", \"cls_count = Counter()\\n\", \"for lbl in train_lbls:\\n\", \"    for line in lbl.read_text().strip().split('\\\\n'):\\n\", \"        if line.strip():\\n\", \"            cls_count[int(line.strip().split()[0])] += 1\\n\", \"\\n\", \"print(f'Train labels: {len(train_lbls)} files')\\n\", \"print(f'Val labels: {len(val_lbls)} files')\\n\", \"print(f'Wreck instances (train): {cls_count.get(0, 0)}')\\n\", \"if any(k != 0 for k in cls_count):\\n\", \"    print(f'WARNING: found non-wreck classes: {dict((k,v) for k,v in cls_count.items() if k!=0)}')\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c6\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "    \"source\": [\"# IMPORTANT: delete old cache to avoid stale class mappings\\n\", \"import glob, os\\n\", \"for c in glob.glob('/content/dataset/**/*.cache', recursive=True):\\n\", \"    os.remove(c)\\n\", \"    print(f'Deleted cache: {c}')\\n\", \"\\n\", \"from ultralytics import YOLO\\n\", \"\\n\", \"model = YOLO('yolo11m.pt')\\n\", \"results = model.train(\\n\", \"    data='/content/dataset.yaml',\\n\", \"    epochs=200,\\n\", \"    imgsz=640,\\n\", \"    batch=8,\\n\", \"    patience=40,\\n\", \"    device=0,\\n\", \"    project='/content/runs',\\n\", \"    name='yolo_at_sea',\\n\", \"    exist_ok=True,\\n\", \"    # SINGLE CLASS detection\\n\", \"    single_cls=True,\\n\", \"    # Freeze backbone (first 10 layers) — critical for small datasets\\n\", \"    freeze=10,\\n\", \"    # Augmentation — aggressive to compensate small dataset\\n\", \"    mosaic=1.0,\\n\", \"    mixup=0.15,\\n\", \"    copy_paste=0.15,\\n\", \"    degrees=20.0,\\n\", \"    translate=0.2,\\n\", \"    scale=0.5,\\n\", \"    flipud=0.5,\\n\", \"    fliplr=0.5,\\n\", \"    hsv_h=0.02,\\n\", \"    hsv_s=0.4,\\n\", \"    hsv_v=0.3,\\n\", \"    erasing=0.2,\\n\", \"    # Learning rate — low for stable fine-tuning\\n\", \"    lr0=0.0005,\\n\", \"    lrf=0.01,\\n\", \"    warmup_epochs=10,\\n\", \"    # Optimizer\\n\", \"    optimizer='AdamW',\\n\", \"    weight_decay=0.0005,\\n\", \"    dropout=0.15,\\n\", \"    # Close mosaic later to exploit augmentation longer\\n\", \"    close_mosaic=20,\\n\", \"    # Save\\n\", \"    save=True,\\n\", \"    save_period=10,\\n\", \"    plots=True,\\n\", \")\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c7\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from IPython.display import Image, display\\n\", \"from pathlib import Path\\n\", \"run_dir = Path('/content/runs/yolo_at_sea')\\n\", \"for p in ['results.png', 'confusion_matrix.png', 'F1_curve.png']:\\n\", \"    f = run_dir / p\\n\", \"    if f.exists():\\n\", \"        print(p)\\n\", \"        display(Image(filename=str(f), width=800))\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c8\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from ultralytics import YOLO\\n\", \"best = '/content/runs/yolo_at_sea/weights/best.pt'\\n\", \"m = YOLO(best)\\n\", \"v = m.val(data='/content/dataset.yaml', imgsz=640, device=0)\\n\", \"print(f'mAP50:    {v.box.map50:.4f}')\\n\", \"print(f'mAP50-95: {v.box.map:.4f}')\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c9\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from ultralytics import YOLO\\n\", \"from pathlib import Path\\n\", \"from IPython.display import Image, display\\n\", \"import random\\n\", \"\\n\", \"model = YOLO('/content/runs/yolo_at_sea/weights/best.pt')\\n\", \"val_imgs = list(Path('/content/dataset/images/val').glob('*'))\\n\", \"samples = random.sample(val_imgs, min(6, len(val_imgs)))\\n\", \"model.predict(samples, save=True, project='/content/runs', name='pred', exist_ok=True)\\n\", \"for p in sorted(Path('/content/runs/pred').glob('*')):\\n\", \"    display(Image(filename=str(p), width=400))\"]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"c10\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\"from google.colab import files\\n\", \"files.download('/content/runs/yolo_at_sea/weights/best.pt')\"]\n",
    "  }\n",
    " ]\n",
    "}\n",
    "\n"
